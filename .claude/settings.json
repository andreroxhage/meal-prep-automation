{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/recipe_guard.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "recipe-creator|recipe-compiler",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent_recipe_gate.sh"
          }
        ]
      }
    ]
  }
}
